# ── Supabase ──────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key

# ── Razorpay ─────────────────────────────────────────────
# Use live key for production: rzp_live_xxxxxxxxxxxxxxxxxxxx
# Get from: dashboard.razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxxxx

# ── Web Push (background order alerts) ───────────────────
# Generate once:  npx web-push generate-vapid-keys
# PUBLIC key goes here (and in Vercel env vars). PRIVATE key goes ONLY in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
